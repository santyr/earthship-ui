// Additive, observational source. No command-capable channel.
Thing http:url:weatherRadiationEvidence "Weather radiation receipt evidence" [
    baseURL="http://127.0.0.1:5000/radiation_evidence",
    refresh=30,
    timeout=3000,
    bufferSize=16,
    stateMethod="GET"
] {
    Channels:
        Type string : snapshot "Complete radiation receipt snapshot" [ mode="READONLY" ]
}
