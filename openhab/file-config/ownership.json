{
  "version": 1,
  "policy": "git_owned_file_first",
  "resources": [
    {
      "kind": "item", "id": "IndoorTemp_24h_High", "provider": "file", "migration": "verified",
      "source": "items/temperature-extrema.items", "destination": "/etc/openhab/items/temperature-extrema.items",
      "state_writer": "temp-highlow-24h"
    },
    {
      "kind": "item", "id": "IndoorTemp_24h_Low", "provider": "file", "migration": "verified",
      "source": "items/temperature-extrema.items", "destination": "/etc/openhab/items/temperature-extrema.items",
      "state_writer": "temp-highlow-24h"
    },
    {
      "kind": "item", "id": "OutdoorTemp_24h_High", "provider": "file", "migration": "verified",
      "source": "items/temperature-extrema.items", "destination": "/etc/openhab/items/temperature-extrema.items",
      "state_writer": "temp-highlow-24h"
    },
    {
      "kind": "item", "id": "OutdoorTemp_24h_Low", "provider": "file", "migration": "verified",
      "source": "items/temperature-extrema.items", "destination": "/etc/openhab/items/temperature-extrema.items",
      "state_writer": "temp-highlow-24h"
    },
    {
      "kind": "item",
      "id": "BTC_Price_24h_PercentChange",
      "provider": "file",
      "migration": "verified",
      "source": "items/bitcoin-change.items",
      "destination": "/etc/openhab/items/bitcoin-change.items",
      "state_writer": "hex_btc_24h_change"
    },
    {
      "kind": "link",
      "id": "BTC_Output_Receipt_JSON -> exec:command:BTC_Price:output",
      "provider": "file",
      "migration": "verified",
      "source": "items/bitcoin-receipt.items",
      "destination": "/etc/openhab/items/bitcoin-receipt.items"
    },
    {
      "kind": "item",
      "id": "BTC_Output_Receipt_JSON",
      "provider": "file",
      "migration": "verified",
      "source": "items/bitcoin-receipt.items",
      "destination": "/etc/openhab/items/bitcoin-receipt.items",
      "state_writer": "exec:command:BTC_Price:output via transform:JS bitcoin_output_receipt.js"
    },
    {
      "kind": "item",
      "id": "Energy_Analytics_JSON",
      "provider": "file",
      "migration": "verified",
      "source": "items/energy-analytics.items",
      "destination": "/etc/openhab/items/energy-analytics.items",
      "state_writer": "energy-ui-publish.service"
    },
    {
      "kind": "rule",
      "id": "1f692c798b",
      "provider": "managed",
      "migration": "inventoried",
      "source": "managed-exceptions/1f692c798b.json",
      "rest_path": "/rules/1f692c798b"
    },
    {
      "kind": "rule",
      "id": "b1501047a9",
      "provider": "managed",
      "migration": "inventoried",
      "source": "managed-exceptions/b1501047a9.json",
      "rest_path": "/rules/b1501047a9"
    }
  ]
}
