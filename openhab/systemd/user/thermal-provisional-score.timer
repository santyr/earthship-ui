[Unit]
Description=Score provisional forecasts between publication preparation windows

[Timer]
OnCalendar=*-*-* *:00/5:10 UTC
OnCalendar=*-*-* *:01/5:10 UTC
OnCalendar=*-*-* *:02/5:10 UTC
OnCalendar=*-*-* *:03/5:10 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=thermal-provisional-score.service

[Install]
WantedBy=timers.target
