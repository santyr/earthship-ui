[Unit]
Description=Check for the one pre-dusk SoC issue window

[Timer]
# Avoid the thermal publisher's minute 04/5:45 through next minute :30.
# Multiple opportunities inside the 30-minute sunset window retry contention.
OnCalendar=*-*-* 14..20:02/10:45 America/Denver
AccuracySec=1s
Persistent=true
Unit=forecast-pre-dusk.service

[Install]
WantedBy=timers.target
