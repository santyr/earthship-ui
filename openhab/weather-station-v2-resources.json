          "itemType": "String",
          "label": "Station ingestion quality and complete v2 snapshot",
          "defaultTags": [],
          "properties": {},
          "configuration": {
            "mode": "READONLY"
          }
        },
        {
          "id": "pressure",
          "uid": "http:url:weatherStationV2:pressure",
          "channelTypeUID": "http:number",
          "kind": "STATE",
