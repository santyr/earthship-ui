          "label": "Station pressure (absolute)",
          "defaultTags": [],
          "properties": {},
          "configuration": {
            "mode": "READONLY",
            "unit": "inHg",
            "stateTransformation": [
              "JSONPATH:$.flat.WeatherStation_PressureAbsoluteV2"
            ]
          }
        },
        {
