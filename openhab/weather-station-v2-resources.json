      "UID": "http:url:weatherStationV2",
      "thingTypeUID": "http:url",
      "label": "WS-2902 corrected station ingestion v2",
      "enabled": false,
      "configuration": {
        "baseURL": "http://127.0.0.1:5000/station_quality",
        "refresh": 30,
        "timeout": 3000,
        "bufferSize": 16384,
        "stateMethod": "GET"
