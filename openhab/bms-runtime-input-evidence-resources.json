{
  "version": 1,
  "createOnly": true,
  "itemSource": "openhab/file-config/items/bms-runtime-input-evidence.items",
  "persistenceExclusion": "!BMS_Runtime_Input_Evidence_JSON",
  "rule": {
    "uid": "hex_bms_runtime_input_evidence",
