[Unit]
Description=Earthship authenticated thermal confirmations and bounded follow-ups

[Service]
Type=oneshot
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/sat/.local/libexec/earthship-thermal/primal-v3/code
EnvironmentFile=/home/sat/.config/hex/thermal-primal-followup.env
ExecStart=/home/sat/.local/libexec/earthship-thermal/primal-v1/venv/bin/python /home/sat/.local/libexec/earthship-thermal/primal-v3/run-recurring.py --run --profile /home/sat/.config/hex/thermal-primal/recurring-v3-profile.json --profile-sha256 @PROFILE_SHA256@
TimeoutStartSec=360
TimeoutStopSec=10
KillMode=control-group
Nice=10
MemoryMax=192M
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

# Render with the independently pinned, recovered private release profile.
# Only thermal-primal.timer schedules this unit. No actuator or operator key.
