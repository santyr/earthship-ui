[Unit]
Description=Score retained WeatherNext forecasts against qualified local measurements
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sat/earthship-ui
EnvironmentFile=%h/.config/earthship-weather/runtime.env
EnvironmentFile=%h/.config/earthship-weather/monitor.env
Environment=PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStart=/usr/bin/python3 ${EARTHSHIP_WEATHER_CODE_ROOT}/scripts/run-household-job.py --production --minimum-mib 256 --preferred-mib 512 --tasks 24 --seconds 120 -- /usr/bin/python3 ${EARTHSHIP_WEATHER_CODE_ROOT}/openhab/scripts/weather_forecast_monitor.py --archive ${EARTHSHIP_WEATHER_ARCHIVE} --state ${EARTHSHIP_WEATHER_SHADOW_STATE} --temperature-policy ${EARTHSHIP_WEATHER_TEMPERATURE_POLICY} --temperature-db-config ${EARTHSHIP_WEATHER_TEMPERATURE_DB_CONFIG} --observation-cutover ${EARTHSHIP_WEATHER_MONITOR_CUTOVER} --code-revision ${EARTHSHIP_WEATHER_CODE_REVISION} --apply
TimeoutStartSec=125
UMask=0077
NoNewPrivileges=true
