[Unit]
Description=Earthship bounded Primal thermal reply collector (release-gated)

[Service]
Type=oneshot
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/sat/.local/libexec/earthship-thermal/primal-v1/code
EnvironmentFile=/home/sat/.config/hex/thermal-primal.env
ExecStart=/home/sat/.local/libexec/earthship-thermal/primal-v1/venv/bin/python /home/sat/.local/libexec/earthship-thermal/primal-v1/code/thermal_primal.py --poll-replies --policy /home/sat/.config/hex/thermal-primal/policy.json --routes /home/sat/.config/hex/thermal-primal/routes.json --state-dir /home/sat/.local/state/thermal-primal --nak ${EARTHSHIP_PRIMAL_NAK} --nak-sha256 ${EARTHSHIP_PRIMAL_NAK_SHA256} --nak-version ${EARTHSHIP_PRIMAL_NAK_VERSION}
TimeoutStartSec=360
TimeoutStopSec=10
KillMode=control-group
Nice=10
MemoryMax=192M
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

# No Install section: only the separately reviewed timer schedules this unit.
# Do not install/start until exact signer, routes, storage and restore gates pass.
