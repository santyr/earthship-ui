[Unit]
Description=Earthship authenticated thermal confirmations and bounded follow-ups

[Service]
Type=oneshot
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/sat/.local/libexec/earthship-thermal/primal-v4/code
EnvironmentFile=/home/sat/.config/hex/thermal-primal-followup.env
ExecStart=/home/sat/.local/libexec/earthship-thermal/primal-v1/venv/bin/python /home/sat/.local/libexec/earthship-thermal/primal-v4/run-recurring.py --run --profile /home/sat/.config/hex/thermal-primal/recurring-v4-auth-profile.json --profile-sha256 e1449a99983f1a82878edff89b9f780459d3c8f2bb1d4a622e9a6da2784594fe
TimeoutStartSec=360
TimeoutStopSec=10
KillMode=control-group
Nice=10
MemoryMax=192M
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

# Render with the independently pinned, recovered private release profile.
# Only thermal-primal.timer schedules this unit. No actuator or operator key.
