# Installed at ~/.config/systemd/user/thermal-model-shadow.service (user unit).
[Unit]
Description=Publish Earthship thermal model shadow observation

[Service]
Type=oneshot
WorkingDirectory=/home/sat/openhab/scripts
EnvironmentFile=/home/sat/.config/hex/openhab.env
ExecStart=/usr/bin/python3 /home/sat/openhab/scripts/thermal_intel.py shadow --publish
TimeoutStartSec=180
