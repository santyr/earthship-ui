[Unit]
Description=Local NIP-46 signer for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=nostr-bunker-%i
RuntimeDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/nostr-bunker/%i.env
LoadCredentialEncrypted=nostr-key:/etc/credstore.encrypted/nostr-bunker-%i.key
ExecStart=/usr/local/libexec/nostr-bunker/run-nak-bunker
# nak bunker can print a one-time connection secret and request/response bodies.
# Do not route either stream to the journal or a persistent file.
StandardOutput=null
StandardError=null
Restart=on-failure
RestartSec=5s
LimitCORE=0

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
