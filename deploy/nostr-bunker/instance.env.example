# One non-secret file per signing identity: /etc/nostr-bunker/<identity>.env.
# Values are examples only; do not use the same signer key across projects.
BUNKER_AUTHORIZED_CLIENTS="REPLACE_WITH_64_HEX_CLIENT_PUBKEY"
BUNKER_RELAYS="wss://relay.example"
NAK_SHA256=REPLACE_WITH_64_HEX_PINNED_BINARY_SHA256
