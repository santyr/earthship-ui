+
+// Opt-in only: existing positional and NIP44 invocation behavior is unchanged.
+func boundedNIP04Input(c *cli.Command) (string, error) {
+	if !c.Bool("stdin") {
+		return c.Args().First(), nil
+	}
+	if !c.Bool("nip04") || c.Args().Len() != 0 {
+		return "", fmt.Errorf("stdin requires NIP04 and no positional input")
+	}
+	input, err := io.ReadAll(io.LimitReader(os.Stdin, 65537))
+	if err != nil || len(input) == 0 || len(input) > 65536 {
+		return "", fmt.Errorf("NIP04 stdin input unavailable or outside bound")
+	}
+	return string(input), nil
+}
