#!/bin/sh
# One-shot, offline identity check. Run only from a root-owned installed copy.
set -eu
set +x
umask 077
ulimit -c 0

NAK=/usr/local/libexec/nostr-bunker/nak
KEY=/etc/credstore.encrypted/nostr-bunker-earthship-operator.key
NOTIFIER=/etc/openhab/misc/nostr_notify.env
APPROVED_NPUB=npub1v60thnx0gz0wq3n6xdnq46y069l9x70xgmjp6lprdl6fv0eux6mqgjj4rp
PIN=ba918fafd1b030bc50958a5b218c6386f4c3a57c1e469562d3947e858e0ba56e

if [ "$(id -u)" -ne 0 ]; then
    echo 'run as root' >&2
    exit 1
fi
if [ ! -f "$NAK" ] || [ -L "$NAK" ] || [ ! -x "$NAK" ] ||
   [ "$(stat -c %u "$NAK")" -ne 0 ] ||
   [ -n "$(find "$NAK" -maxdepth 0 -perm /022 -print)" ] ||
   [ "$(sha256sum "$NAK" | cut -d ' ' -f 1)" != "$PIN" ]; then
    echo 'qualified root-owned nak binary unavailable' >&2
    exit 1
fi

# Extract only the public recipient value; never source the notifier secrets.
expected=$(sed -n 's/^NOTIFY_PUBKEY_HEX=//p' "$NOTIFIER")
case "$expected" in
    *[!0123456789abcdefABCDEF]*|'') echo 'invalid notifier recipient' >&2; exit 1 ;;
esac
if [ "${#expected}" -ne 64 ]; then
    echo 'invalid notifier recipient length' >&2
    exit 1
fi
expected=$(printf '%s' "$expected" | tr 'ABCDEF' 'abcdef')
approved=$("$NAK" decode --pubkey "$APPROVED_NPUB") || {
    echo 'approved npub is invalid' >&2
    exit 1
}
if [ "$expected" != "$approved" ]; then
    echo 'OpenHAB DM recipient differs from approved npub' >&2
    exit 1
fi

# The plaintext exists only in this root shell and nak's environment. It is
# never put in argv, a file, the repository, the journal, or command output.
secret=$(systemd-creds decrypt --name=nostr-key "$KEY" -) || {
    echo 'credential decryption failed' >&2
    exit 1
}
if [ -z "$secret" ]; then
    echo 'empty credential' >&2
    exit 1
fi
actual=$(NOSTR_SECRET_KEY="$secret" "$NAK" key public) || {
    unset secret
    echo 'public-key derivation failed' >&2
    exit 1
}
unset secret
if [ "$actual" = "$approved" ]; then
    echo 'operator credential matches existing DM recipient'
else
    echo 'operator credential does NOT match existing DM recipient' >&2
    exit 1
fi
