#!/usr/bin/env python3
"""Attended Sat-client NIP-46 challenge; never prints or persists key material."""

import getpass
import hashlib
import json
import os
import stat
import subprocess
import sys
import uuid
from pathlib import Path
from urllib.parse import urlencode


NAK = Path('/usr/local/libexec/nostr-bunker/nak')
NAK_SHA256 = 'ba918fafd1b030bc50958a5b218c6386f4c3a57c1e469562d3947e858e0ba56e'
CLIENT = '5302cd2bfe2dcc76c5a9abcba74e6c5f1a07444b35c25e0cd74bac5b453fb5f6'
OPERATOR = '669ebbcccf409ee0467a33660ae88fd17e5379e646e41d7c236ff4963f3c36b6'
RELAYS = ('wss://nos.lol', 'wss://relay.primal.net', 'wss://relay.damus.io')
UNIT = 'nostr-bunker@earthship-operator.service'


class ChallengeError(Exception):
    pass


def call(args, *, env=None, data=None, timeout=60):
    try:
        result = subprocess.run(args, input=data, capture_output=True, text=True,
                                env=env, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ChallengeError('command unavailable or timed out') from error
    if result.returncode:
        # nak errors may contain the bunker URI; never echo its output.
        raise ChallengeError('command failed')
    return result.stdout.strip()


def main():
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        raise ChallengeError('run from a private interactive terminal')
    info = NAK.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
            or info.st_mode & 0o022 or hashlib.sha256(NAK.read_bytes()).hexdigest() != NAK_SHA256):
        raise ChallengeError('pinned nak executable failed integrity check')

    status = call(['systemctl', 'show', '-p', 'ActiveState', '-p', 'SubState',
                   '-p', 'UnitFileState', UNIT], timeout=10)
    if not all(field in status.splitlines() for field in
               ('ActiveState=active', 'SubState=running', 'UnitFileState=enabled')):
        raise ChallengeError('operator bunker is not running and enabled')

    client_nsec = getpass.getpass('Sat client nsec (hidden): ')
    if not client_nsec:
        raise ChallengeError('empty client key')
    env = {k: v for k, v in os.environ.items()
           if k in {'PATH', 'HOME', 'LANG', 'LC_ALL', 'XDG_CONFIG_HOME'}}
    env['NOSTR_SECRET_KEY'] = client_nsec
    try:
        client_pub = call([str(NAK), 'key', 'public'], env=env, timeout=10)
        if client_pub != CLIENT:
            raise ChallengeError('client key does not match approved allowlist')

        env['NOSTR_CLIENT_KEY'] = client_nsec
        env['NOSTR_SECRET_KEY'] = 'bunker://' + OPERATOR + '?' + urlencode(
            [('relay', relay) for relay in RELAYS])
        remote_pub = call([str(NAK), 'key', 'public'], env=env)
        if remote_pub != OPERATOR:
            raise ChallengeError('remote signer returned an unexpected identity')

        content = 'Earthship NIP-46 connection test; no control action. ' + uuid.uuid4().hex[:12]
        event = json.loads(call([str(NAK), 'event', '--kind', '1', '--content', content], env=env))
        if (event.get('pubkey') != OPERATOR or event.get('kind') != 1
                or event.get('content') != content):
            raise ChallengeError('signed test note has unexpected fields')
        signed = json.dumps(event, separators=(',', ':')) + '\n'
        call([str(NAK), 'verify'], data=signed, timeout=10)
    finally:
        client_nsec = ''
        env.pop('NOSTR_CLIENT_KEY', None)
        env.pop('NOSTR_SECRET_KEY', None)

    # The user explicitly authorized one short public test note. Publish the
    # same signed event to the approved relays, then require an exact readback.
    confirmed = 0
    for relay in RELAYS:
        try:
            call([str(NAK), 'event', relay], data=signed, timeout=30)
            records = call([str(NAK), 'req', '--id', event['id'], '--limit', '1', relay],
                           timeout=30)
            if any(json.loads(line).get('id') == event['id']
                   for line in records.splitlines() if line.strip()):
                confirmed += 1
        except (ChallengeError, json.JSONDecodeError):
            continue
    if not confirmed:
        raise ChallengeError('no relay returned the published note; delivery not verified')
    print(f'NIP-46 signer challenge passed; operator test note read back on {confirmed}/{len(RELAYS)} relays.')
    print(f'Public test event ID: {event["id"]}')


if __name__ == '__main__':
    try:
        main()
    except (ChallengeError, ValueError, KeyError, OSError) as error:
        # Only controlled error messages appear here; never print subprocess
        # stderr, arguments, environment, or traceback containing a key/URI.
        print(f'Challenge incomplete: {error}', file=sys.stderr)
        sys.exit(1)
